DATABASE_URL=postgres://run_method:run_method@localhost:5432/run_method
# DATABASE_CA_PATH=/run/secrets/rds-ca-bundle.pem
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/run-method/protocol/openid-connect/auth
OIDC_CALLBACK_URL=http://localhost:3000/auth/callback
OIDC_CLIENT_ID=run-method
OIDC_JWKS_URL=http://localhost:8080/realms/run-method/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8080/realms/run-method
OIDC_AUDIENCE=run-method
OIDC_TOKEN_ENDPOINT=http://localhost:8080/realms/run-method/protocol/openid-connect/token
KEYCLOAK_ADMIN_USERNAME=replace-with-local-admin-username
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-admin-password
KEYCLOAK_TEST_USER_PASSWORD=replace-with-local-test-user-password

OIDC_PROVIDER=keycloak
OIDC_LOGOUT_ENDPOINT=http://localhost:8080/realms/run-method/protocol/openid-connect/logout
APP_BASE_URL=http://localhost:3000/
